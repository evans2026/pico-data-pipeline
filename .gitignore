# .gitignore

# ── NEVER commit these ──
config/config.yaml       # contains WiFi creds and local paths
*.env
.env*

# ── Database files ──
data/
*.db
*.sqlite

# ── Logs ──
logs/
*.log

# ── Python ──
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
.eggs/
venv/
.venv/
env/

# ── OS / editor junk ──
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
